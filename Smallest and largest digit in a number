import java.util.*;
class Main{
	public static void main(String[] args){
		int n = 2344874;
		int sm = Integer.MAX_VALUE;
		int la = Integer.MIN_VALUE;
		while (n!= 0){
			if (n%10 > la){
				la = n%10;
			}
			else if (n%10 < sm){
				sm = n%10;
			}			
			n/=10;
		}
		System.out.println(sm + " is the smallest number");
		System.out.println(la + " is the largest number");	
		
	}
}

import java.util.*;
class Main{
	public static void main(String[] args){
		Scanner sc=new Scanner(System.in);
		int n = sc.nextInt();
		int[] arr = new int[n];
	    for (int i=0;i<n;i++){
	    	arr[i] = sc.nextInt();
	    }
	    int smallest = Integer.MAX_VALUE;
	    for (int j = 0; j<n;j++){
	    	if (arr[j]<smallest) smallest = arr[j];
	    }
	    System.out.print(smallest);
	}
}

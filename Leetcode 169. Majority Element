class Solution {
    public int majorityElement(int[] nums) {
        Arrays.sort(nums);
        int res = 0;
        HashMap <Integer , Integer> map = new HashMap<>();
        for (int num : nums){
            if (map.containsKey(num)){
                map.put(num,map.get(num) + 1);
            }
            else {
                map.put(num,1);
            }            
        }
        for (int val:map.keySet()) {
            if (map.get(val) > (nums.length/2)){ 
                res = val;
                break;
            }
        }
        return res;
    }
}

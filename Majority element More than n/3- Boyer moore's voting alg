class Solution {
    public ArrayList<Integer> findMajority(int[] arr) {
        int n = arr.length;
        int a1= -1,a2 = -1;
        int c1 = 0, c2 = 0;
        for(int i : arr){
            if (a1 == i){
                c1++;
            }
            else if( a2 == i){
                c2++;
            }
            else if( c1 == 0){
                a1 = i;
                c1++;
            }
            else if ( c2 == 0){
                a2 = i;
                c2++;
            }
            else {
                c1--;
                c2--;
            }
        }
        ArrayList<Integer> res = new ArrayList<>();
        c1 = 0;
        c2 = 0;
        for (int j : arr){
            if (a1 == j) c1++;
            else if(a2 == j) c2 ++;
        }
        if ( c1 > n/3){
            res.add(a1);
        }
        if (c2 > n/3) {
            res.add(a2);
        }
        if(res.size() == 2){
            if (res.get(0) > res.get(1)){
                int temp = res.get(0);
                res.set(0, res.get(1));
                res.set(1, temp);
             }
        }
        return res;
    }
}

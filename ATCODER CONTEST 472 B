import java.util.*;
class Main{
  public static void main(String[] args){
    Scanner sc = new Scanner(System.in);
    int n = sc.nextInt();
    int arr[] = new int[n];
    for (int i = 0; i<n; i++){
    	arr[i] = sc.nextInt();
    }
    int res = Integer.MAX_VALUE;
    int sumtillj = 0;
    for (int j = 0; j<n;j++){
    	sumtillj+= arr[j];
    	int sumtillk = 0;
    	for(int k = j+1; k<n;k++){
    		sumtillk+= arr[k];    		    		
    	}    	
    	if ( res > Math.abs(sumtillj-sumtillk)){
    		res = Math.abs(sumtillj - sumtillk);
    	}
    }
    System.out.println(res);
  }
}

class Solution {
    public int maxProfit(int[] prices) {
        int i = 0;
        int lmin = prices[0];
        int lmax = prices[0];
        int res = 0;
        while (i < prices.length-1){
            while ((i < prices.length-1) && (prices[i] >= prices[i+1])){
                i+=1;
            }
            lmin = prices[i];
            while ((i < prices.length-1)&&(prices[i] <= prices[i+1])){
                i+=1;
            }
            lmax = prices[i];
            res += lmax - lmin;
        }
        return res;
    }
}

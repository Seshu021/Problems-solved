import java.util.*;
class Main{
	public static void main(String[] args){
		Scanner sc = new Scanner(System.in);
		HashMap<Integer,Integer> map = new HashMap<>();
		int n = sc.nextInt();
		for (int i = 0; i<n; i++){
			int x = sc.nextInt();
			if (map.containsKey(x)){
				map.put(x,map.get(x) + 1);
			}
			else{
				map.put(x,1);
			}
		}
		int sum = 0;
		for (int num : map.keySet()){
			if (map.get(num) % 2 == 1){
				sum += num;
			}
		}
		System.out.println(sum);
		
	}
}

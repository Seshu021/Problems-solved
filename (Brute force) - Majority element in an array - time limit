class Solution {
    public int majorityElement(int[] nums) {
        int res = 0;
        int fin = 0;
        for (int i = 0;i<nums.length;i++){
            int count = 0;
            for (int j = 0; j<nums.length;j++){
                if (nums[i] == nums[j]){
                    count++;
                }
            }
            if (count>res) {
                res = count;
                fin = nums[i];
            }
        }
        return fin;
        
    }
}

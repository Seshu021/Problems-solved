import java.util.*;
class Main{
  public static void main(String[] args){
    Scanner sc = new Scanner(System.in);
    int N = sc.nextInt();
    int mid = N/2;
    int sum = 0;
    for (int i = 0; i<N;i++){
    	int temp = sc.nextInt();
    	if (i>=mid){
        	sum+=temp;
      	}
    }
    System.out.println(sum);
  }
}

import java.util.*;
class Main{
	public static void main(String[] args){
		Scanner sc=new Scanner(System.in);
		int n = sc.nextInt();
		int[] arr = new int[n];
	    for (int i=0;i<n;i++){
	    	arr[i] = sc.nextInt();
	    }
		int pos = 0, neg = 0, zero  = 0;
		for (int j = 0;j<n;j++){
			if (arr[j]>0) pos++;
			else if (arr[j]<0) neg++;
			else zero++;
		}
		System.out.print("POSITIVE COUNT " + pos + "\nNEGATIVE COUNT " + neg + "\nZERO COUNT " + zero);
	
	}
	
}

class Solution {
    public int maxProfit(int[] prices) {
        int min = prices[0];
        int res = 0;
        for (int i = 0; i < prices.length; i++){
            min = (min < prices[i]) ? min : prices[i];
            res = (res > prices[i] - min) ? res : prices[i] - min;
        }
        return res;
    }
}
